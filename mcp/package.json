    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/bountyoperator/bounty-operator/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "bug-bounty",
    "security",
    "smart-contracts",
    "solidity",
    "audit",
    "code-review"
