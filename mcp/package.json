{
  "name": "bounty-operator-mcp",
  "version": "0.9.7",
  "description": "MCP server for Bounty Operator: argue against a security finding or a draft report before you submit it.",
  "mcpName": "io.github.bountyoperator/bounty-operator",
  "type": "module",
  "license": "MIT",
  "author": "Tradi3",
  "homepage": "https://bountyoperator.com/mcp",
  "repository": {
