{
  // The public template: local development, the test suites and a fork's own
  // deploy run from this file. It names no account, no route and no live
  // database, and billing is off.
  //
  // The production values of bountyoperator.com (account, routes, database id,
  // Stripe ids) live in wrangler.production.jsonc, which git does not track.
  // `npm run deploy` deploys from that file and refuses when it is missing.
  // The Worker name below is not the production one, so `wrangler deploy` run
  // here by mistake cannot replace the production Worker.
  //
  // To deploy your own copy: set a route or `workers_dev`, your D1 database id
  // and SITE_ORIGIN, then `npx wrangler deploy`. Its /api/health reads
  // "profiles": "community".
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bounty-operator-dev",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-18",
  // enable_request_signal: request.signal aborts when the client disconnects,
  // which stops the provider call and releases the review lease.
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  // A streamed review costs CPU for every token it relays: about a second for
  // a 64,000-token answer, more than the privacy scan of a full 240 KB input.
  // CPU is billed by use, so this cap only stops a runaway invocation.
  "limits": { "cpu_ms": 30000 },
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Every request runs the Worker, so redirects and headers are set in one place.
    "run_worker_first": true,
    // guide.html is served at /guide, and /guide.html redirects there.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": {
    // The one origin the site answers on. GET and HEAD on any other host are
    // redirected here. `npm run dev` sets it to the local address.
    "SITE_ORIGIN": "http://localhost:8787",
    "BILLING_MODE": "disabled",
    "STRIPE_PRICE_ID": "",
    "STRIPE_PORTAL_CONFIGURATION": "",
    "AI_REVIEW_ENABLED": "true",
    "INFERENCE_ENABLED": "false",
    "API_TOPUPS_ENABLED": "false",
    "API_AUTOTOPUPS_ENABLED": "false",
    "INFERENCE_MODELS": "[]",
    // Verified, expiring supplier cost rules. A funded D1 budget is also required.
    "SUPPLIER_COST_RULES": "[]",
    // Confirmed customer credit funds that budget: the share, a decimal string
    // from "0" to "1", of each paid top-up or monthly credit grant added to
    // every selling provider's current window. Unset also means "0.9"; "0"
    // turns automatic funding off; an unreadable value counts as "0" and is
    // logged. The production file must carry the same key.
    "SUPPLIER_BUDGET_SHARE": "0.9",
    // The */15 cron emails the owner when the RunPod balance drops below this
    // many USD (or the account is under its minimum balance). Unset, blank or
    // unreadable means 10.
    "RUNPOD_ALERT_USD": "10",
    // Where owner alerts go. Blank here, so the template sends none. Production
    // sets it to exactly the ALERT_EMAIL binding's destination_address below.
    "ALERT_EMAIL_TO": ""
  },
  // Secrets, set with `wrangler secret put`: STRIPE_SECRET_KEY,
  // STRIPE_WEBHOOK_SECRET, IP_HASH_KEY, RUNPOD_API_KEY.
  //
  // Owner alerts (RunPod balance low or exhausted, model sales stopped or back,
  // a cost rule or budget window about to end, RunPod unreadable) need a
  // send_email binding named ALERT_EMAIL. It is left out here on purpose: with
  // no binding the cron sends nothing, so local development and a fork stay
  // quiet. Production adds it, pinned to the owner's verified Email Routing
  // destination (a real inbox, not a routing rule such as support@):
  //   "send_email": [
  //     { "name": "ALERT_EMAIL", "destination_address": "owner@example.com" }
  //   ]
  // and sets ALERT_EMAIL_TO to the same address. Mail comes from
  // alerts@bountyoperator.com. There is no default recipient: with the binding
  // and a blank ALERT_EMAIL_TO the watch reports not_configured and sends
  // nothing, and `npm run deploy` refuses a production file where the two differ.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    // Keeps ?ref= codes and Checkout session ids out of the logs.
    "redact_query_string": true,
    "issues": { "enabled": true },
    // No invocation logs: they would keep every request's IP address, user agent
    // and location for seven days, which the privacy page says is never stored.
    // The Worker's own console lines hold none of that.
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false }
  },
  // Daily purge of expired rows, and a sweep of stale review leases every 15 minutes.
  "triggers": { "crons": ["17 3 * * *", "*/15 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bounty-operator-accounts",
      // A placeholder. Local development needs no real id; a deploy needs yours.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  // The first gate on every API POST: 120 per minute per network address,
  // counted at the edge with no database write.
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "7001", "simple": { "limit": 120, "period": 60 } }
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" }
}
